resource_name = "Bad-sensor"
script/source = "extends Area2D
func _on_body_entered(body: Node) -> void:
	if body.is_in_group(\"player\"):
		print(\"found player\")
		call_deferred(\"change_scene\",body)
	print(body.name)
	print(body.get_groups())
func change_scene(body:CharacterBody2D)->void:
	body.wierdness = 5
	print(\"success on weirdness\")
	print(body.wierdness)
	print(body.get_instance_id())
"

