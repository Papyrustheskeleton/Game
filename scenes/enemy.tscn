[sub_resource type="GDScript" id="GDScript_4pxsk"]
script/source = "extends CharacterBody2D
enum State{PATROL,CHARGE,ATTACK}
var state = State.PATROL
@export var patrol_speed:float =40.00
@export var charge_speed:float = 180.00
@export var patrol_points: Array[Vector2]=[]
@export var battle_scene: PackedScene
var patrol_index: int = 0
var start_pos: Vector2
var player: Node2D = null
func _ready():
	start_pos = global_position
func _physics_process(delta):
	match state:
		State.PATROL:
			_patrol(delta)
		State.CHARGE:
			_charge(delta)
		State.ATTACK:
			State.ATTACK
func _patrol(delta):
	if patrol_points.is_empty():
		return
	var target = start_pos + patrol_points[patrol_index]
	if abs(global_position.x - target.x) > 2.0:
		velocity = Vector2(sign(target.x - global_position.x)* patrol_speed,0)
	elif abs(global_position.y - target.y) > 2.0:
		velocity = Vector2(0,sign(target.y - global_position.y) * patrol_speed)
	else:
		patrol_index = (patrol_index + 1) % patrol_points.size()
		velocity = Vector2.ZERO
	move_and_slide()
func _charge(delta):
	if player == null:
		state = State.PATROL
		return
	var direction = player.global_position - global_position
	if direction.length() > 20.00:
		velocity = direction.normalized() * charge_speed*2
	else:
		_start_attack()
	move_and_slide()
func _start_attack():
	if state == State.ATTACK:
		return
	state = State.ATTACK
	velocity = Vector2.ZERO
	if battle_scene == null:
		push_error(\"No battle scene has been assigned\")
		return
	get_tree().call_deferred(\"change_scene_to_packed\", battle_scene)

func _on_area_2d_body_entered(body: Node2D) -> void:
	if body.name == \"player\":
		player = body
		
		state = State.CHARGE



func _on_area_2d_body_exited(body: Node2D) -> void:
	pass


func _on_deadzone_body_entered(body: Node2D) -> void:
	if body.name == \"player\":
		body=player
		_start_attack()
	print(\"in deadzone\")



func _on_deadzone_body_exited(body: Node2D) -> void:
	pass 
"

