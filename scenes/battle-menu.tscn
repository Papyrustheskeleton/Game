[sub_resource type="GDScript" id="GDScript_2ni0y"]
resource_name = "Battle1"
script/source = "extends Control
@onready var textbox = $TextBox
@onready var text = $TextBox/Text
@onready var message = \"ribbit\"
@onready var current_turn = 0
@onready var Fight = $Fight
@onready var box = $Box
@onready var enemy = $Enemy
@onready var player = $Box/player
@export var attack1 : PackedScene
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if current_turn == 1:
		box.visible = false
		await get_tree().create_timer(0.05).timeout
		text.text = message
		text.visible_characters = 0
		for i in range(message.length()):
			text.visible_characters +=1
	elif current_turn == 0:
		textbox.visible = false
		Fight.visible = false
		enemy.position.y -= 50
		box.visible = true
		start_attack()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func start_attack():
	var center = $Center
	var attack = attack1.instantiate()
	attack.position = center.position
	add_child(attack)
"

