[sub_resource type="GDScript" id="GDScript_o6cfq"]
script/source = "extends Node

func _on_sensor_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		print(\"player detected\")
		change_room(\"res://rooms/level_2.tscn\")

func change_room(next_room_path: String) -> void:
	var current_room = $RoomContainer.get_child(0)
	current_room.queue_free()

	var new_room = load(next_room_path).instantiate()
	$RoomContainer.add_child(new_room)
"

